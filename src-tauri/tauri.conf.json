{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "clinicincome",
  "version": "0.1.0",
  "identifier": "com.clinicincome.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "受雇醫師收入記帳系統",
        "width": 1200,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["rpm", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "category": "Finance",
    "shortDescription": "受雇醫師收入記帳系統",
    "longDescription": "專為受雇醫師設計之診所薪資、PPF抽成、值班與代診收入記帳軟體，支援薪資單照片憑證與每月統計。",

    "linux": {
      "rpm": {
        "depends": ["webkit2gtk4.1", "gtk3"]
      }
    }
  }
}
